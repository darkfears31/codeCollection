class Solution {
public:
    vector<int> intersection(vector<int>& nums1, vector<int>& nums2) {
        vector<int> result;
        for(int i=0;i<nums1.size();i++){
            for(int k=0;k<nums2.size();k++){
                if(nums1[i]==nums2[k]){
                    bool found = false;
                    for(int j=0; j<result.size(); j++){
                        if(result[j]==nums1[i]){
                            found = true;
                            break;
                        }
                    }
                    if(!found) result.push_back(nums1[i]);
                }
            }
        }
        return result;
    }
};
